---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
// 分享导出模态框样式：原来由 global.css 全局引入，现按需加载
import '../styles/share-export.css';
import Sidebar from '../components/Sidebar/index.astro';
import SiteCard from '../components/SiteCard/index.astro';
import SearchModal from '../components/SearchModal.jsx';
import ShareExportModal from '../components/ShareExportModal.jsx';
import ThemePicker from '../components/ThemePicker/index.astro';
import ResourceFilter from '../components/ResourceFilter.astro';
import siteConfig from '../content/site-settings/config.json';
import { Menu, Search, Command, Share2, MoreHorizontal, SquarePen } from 'lucide-react';
import { sortResourcesByStatus } from '../utils/resourceStatus';
import { buildShareTree, getNavIcon, loadNavResources } from '../utils/navData';

// Keystatic 后台入口：路径跟随部署 base（github → /my-nav/keystatic，root/admin → /keystatic）
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const keystaticUrl = `${basePath}/keystatic/`;

// 1. 获取数据（页面 → 分组 → 分类 / Tab，含 guide_id 关联与排序）
const navResources = await loadNavResources();

// 2. 确定当前页面
const currentId = 'home'; 
const section = navResources.find(r => r.id === currentId) || navResources[0] || { name: 'Loading...', groups: [], icon: undefined };

// 3. 图标
const CurrentIcon = getNavIcon(section.icon);
---

<Layout title={`${siteConfig.title} - ${section.name}`}>
  
  <div class="flex min-h-screen w-full">
    
    <Sidebar navResources={navResources} currentId={currentId} siteConfig={siteConfig} />
    
    <div id="sidebar-overlay"></div>

    <main class="layout-transition flex-1 min-w-0 md:ml-[var(--sidebar-width,17rem)] min-h-screen flex flex-col">
      {/* 顶部 Header */}
      <header id="page-header" class="layout-transition fixed top-0 right-0 z-30 flex items-center gap-2 md:gap-4 px-4 md:px-8 py-4 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-slate-200/50 dark:border-gray-800/50 w-full md:w-[calc(100%-var(--sidebar-width,17rem))] transition-all duration-300">
        
        <div id="header-left-group" class="flex items-center gap-3 min-w-0 max-w-[45%] shrink">
          <button id="menu-btn" class="p-2 text-slate-600 dark:text-slate-300 bg-white/80 dark:bg-gray-800/80 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 shrink-0 hover:text-brand-600 transition-colors" onclick="if(window.innerWidth < 768) window.toggleSidebarMobile(); else window.toggleSidebarPC();">
            <Menu size={20} />
          </button>
          
          <h1 class="text-xl font-black flex items-center gap-3 text-slate-800 dark:text-white truncate min-w-0">
            <div class="p-2 bg-brand-50 dark:bg-brand-900/30 rounded-lg text-brand-600 shrink-0"><CurrentIcon size={20} /></div>
            <span class="truncate transition-all duration-300">{section.name}</span>
          </h1>
        </div>

        {/* 搜索框：顶栏居中 */}
        <div id="header-search-center" class="flex-1 min-w-0 flex items-center justify-center px-1 md:px-4">
          <button id="header-search-btn" class="w-full max-w-md flex items-center gap-2 px-3 py-1.5 text-sm text-slate-400 bg-slate-100 dark:bg-slate-800 rounded-xl hover:ring-2 hover:ring-brand-500/20 transition-all border border-slate-200 dark:border-slate-700" title="搜索（⌘K）" onclick="window.dispatchEvent(new CustomEvent('open-search-modal'))">
            <Search size={16} className="shrink-0" />
            <span class="flex-1 truncate text-left">搜索...</span>
            <kbd class="hidden sm:flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-sans font-medium text-slate-500 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md shrink-0">
              <Command size={10} />K
            </kbd>
          </button>
        </div>
        
        <div id="header-actions-container" class="relative flex items-center gap-2 shrink-0">
          {/* Keystatic 后台入口（新标签页打开） */}
          <a id="keystatic-admin-link" href={keystaticUrl} target="_blank" rel="noopener noreferrer" class="p-2 text-slate-500 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400 bg-white/50 dark:bg-gray-800/50 hover:bg-brand-50 dark:hover:bg-brand-900/30 rounded-lg shadow-sm border border-gray-200/50 dark:border-gray-700/50 shrink-0 transition-all duration-200" title="打开 Keystatic 后台（新标签页）" aria-label="打开 Keystatic 后台">
            <SquarePen size={20} />
          </a>

          {/* 更多操作：状态筛选 / 分享 / 主题 折叠于此 */}
          <button id="header-actions-trigger" class="p-2 text-slate-500 hover:text-brand-600 bg-white/80 dark:bg-gray-800/80 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 transition-all duration-300 z-[60] focus:outline-none relative" title="更多操作" aria-label="更多操作" aria-haspopup="true">
            <MoreHorizontal size={20} className="transition-transform duration-300" id="header-actions-icon" />
          </button>

          <div id="header-actions-group" class="absolute right-0 top-[calc(100%+0.5rem)] w-56 flex flex-col gap-1 p-2 bg-white/95 dark:bg-slate-900/95 backdrop-blur-2xl rounded-2xl shadow-xl border border-gray-200/60 dark:border-gray-700/60 transition-all duration-200 origin-top-right scale-95 opacity-0 invisible pointer-events-none z-50">
            <ResourceFilter />
            
            <button class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-gray-700/60 hover:text-brand-600 dark:hover:text-brand-400 transition-colors text-left" title="分享页面资源" onclick="if(window.__PAGE_SHARE_TREE__) window.dispatchEvent(new CustomEvent('open-share-modal', { detail: { tree: window.__PAGE_SHARE_TREE__, title: window.__PAGE_SHARE_TITLE__ || '资源推荐', activeId: window.__ACTIVE_SHARE_ID__ || null } }))">
              <Share2 size={18} className="shrink-0" />
              <span>分享页面</span>
            </button>
            
            <ThemePicker />
          </div>
        </div>
      </header>

      {/* 内容区域 */}
      <div transition:name="main-content" class="p-4 pt-24 md:p-8 md:pt-28 space-y-12 w-full max-w-[1440px] mx-auto">
        {(section.groups || []).length === 0 && (
           <div class="text-center text-slate-400 mt-20">暂无内容，请在后台配置分组并关联到此页面。</div>
        )}

        {(section.groups || []).map((group: any, groupIdx: number) => (
          <div class="group-wrapper w-full">
            <div id={`group-${groupIdx}`} class="flex items-center gap-3 mb-8 mt-12 first:mt-0 pb-2 border-b border-slate-100 dark:border-slate-800 scroll-mt-28 share-observe-target">
              <h2 class="text-xl font-black text-slate-800 dark:text-slate-100">
                 {group.visualTag && <span class="mr-2">{group.visualTag}</span>}
                 {group.name}
              </h2>
            </div>
            
            <div class="space-y-16 w-full">
              {/* 分组直属资源 */}
              {group.resources && group.resources.length > 0 && (
                <section class="group-resources mb-8 w-full">
                  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 2xl:grid-cols-7 gap-3 md:gap-4 pt-1 w-full">
                    {sortResourcesByStatus(group.resources).map((site: any, cardIdx: number) => <SiteCard {...site} animationDelay={cardIdx * 30} />)}
                  </div>
                </section>
              )}

              {/* Categories */}
              {(group.categories || []).map((category: any, catIdx: number) => {
                const uniqueId = `${groupIdx}-${catIdx}`;
                const hasList = category.resources && category.resources.length > 0;
                const hasTabs = category.tabs && category.tabs.length > 0;
                if (!hasList && !hasTabs) return null;

                return (
                  <section id={`cat-${uniqueId}`} class="category-group scroll-mt-28 w-full share-observe-target">
                    <div class="flex flex-wrap items-center justify-start gap-x-6 gap-y-4 mb-8">
                      <h3 class="flex items-center gap-3 text-lg font-bold text-slate-700 dark:text-slate-200 shrink-0">
                        <span class="w-1.5 h-5 bg-brand-600 rounded-full"></span>
                        {category.name}
                      </h3>

                      {/* Tab 按钮 */}
                      {hasTabs && (
                        <div class="flex items-center gap-2">
                          <div class="tab-nav-container relative z-0 flex bg-slate-200/50 dark:bg-slate-800/50 p-1 rounded-full overflow-x-auto no-scrollbar max-w-full isolate">
                            <div class="tab-indicator absolute bg-white dark:bg-slate-700 shadow-sm rounded-full h-[calc(100%-8px)] top-1 transition-all duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1.0)] transform-gpu pointer-events-none"></div>

                            {category.tabs.map((tab: any, tabIdx: number) => (
                              <button
                                class={`tab-btn relative z-10 px-4 py-1.5 text-xs font-bold rounded-full transition-colors duration-200 whitespace-nowrap focus:outline-none focus:ring-0
                                ${tabIdx === 0 ? 'text-brand-600 active-tab' : 'text-slate-500 hover:text-slate-700 dark:text-slate-400'}`}
                                data-target={`pane-${uniqueId}-${tabIdx}`}
                                data-index={tabIdx}
                              >
                                {tab.tabName}
                              </button>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>

                    <div class="tab-content-wrapper relative z-10 w-full">
                      {/* 直属资源 */}
                      {hasList && (
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 2xl:grid-cols-7 gap-3 md:gap-4 pt-1 w-full mb-8">
                          {sortResourcesByStatus(category.resources).map((site: any, cardIdx: number) => <SiteCard {...site} animationDelay={cardIdx * 30} />)}
                        </div>
                      )}

                      {/* Tab 内容 */}
                      {hasTabs && (
                        category.tabs.map((tab: any, tabIdx: number) => (
                          <div 
                            id={`pane-${uniqueId}-${tabIdx}`} 
                            class={`tab-pane animate-fade-in relative z-20 w-full ${tabIdx !== 0 ? 'hidden' : ''}`}
                          >
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 2xl:grid-cols-7 gap-3 md:gap-4 pt-1 w-full">
                              {sortResourcesByStatus(tab.list || []).map((site: any, cardIdx: number) => <SiteCard {...site} animationDelay={cardIdx * 30} />)}
                            </div>
                          </div>
                        ))
                      )}
                    </div>
                  </section>
                );
              })}
            </div>
          </div>
        ))}
        
        <footer class="mt-20 py-10 text-center text-[13px] text-slate-400 border-t border-slate-200/50 dark:border-gray-800/50">
          <p>Made with ❤️ by {siteConfig.author} © {new Date().getFullYear()}</p>
        </footer>
      </div>
    </main>
  </div>
  
  <SearchModal client:idle />
  {/* 分享导出模态框 */}
  <ShareExportModal client:idle />
</Layout>

<script define:vars={{ shareTree: buildShareTree(section.groups || []), shareTitle: section.name }}>
  window.__PAGE_SHARE_TREE__ = shareTree;
  window.__PAGE_SHARE_TITLE__ = shareTitle;
</script>

{/* 顶栏响应式折叠监听 */}
<script>
  import { initHeaderCollapse } from '../scripts/header-collapse';

  document.addEventListener('astro:page-load', initHeaderCollapse);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderCollapse);
  } else {
    initHeaderCollapse();
  }
</script>

{/* IntersectionObserver 页面区块定位监听 */}
<script>
  import { initShareObserver } from '../scripts/share-observer';

  document.addEventListener('astro:page-load', initShareObserver);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShareObserver);
  } else {
    initShareObserver();
  }
</script>

{/* 平滑滚动导航增强 */}
<script>
  import { initScrollHelpers } from '../scripts/scroll-helpers';

  initScrollHelpers();
</script>

<style>
  /* 滚动目标激活时的视觉效果 */
  .scroll-target-active {
    animation: scroll-target-pulse 0.5s ease-out;
  }
  
  @keyframes scroll-target-pulse {
    0% { background-color: transparent; }
    30% { background-color: rgba(79, 70, 229, 0.1); }
    100% { background-color: transparent; }
  }
  
  :global(.dark) .scroll-target-active {
    animation: scroll-target-pulse-dark 0.5s ease-out;
  }
  
  @keyframes scroll-target-pulse-dark {
    0% { background-color: transparent; }
    30% { background-color: rgba(99, 102, 241, 0.15); }
    100% { background-color: transparent; }
  }
</style>
