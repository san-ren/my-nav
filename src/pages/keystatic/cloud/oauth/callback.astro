---
// Keystatic Cloud 的 OAuth 回调页 —— 必须真实存在于构建产物中。
//
// 原因：@keystatic/core 里回调地址被写死为
//   `${window.location.origin}/keystatic/cloud/oauth/callback`
// 静态托管（GitHub Pages）下这个路径没有真实文件，会落到 404.html，
// 而 fallback 的 location.replace() 会把 ?code=&state= 查询串丢掉，
// 导致应用拿不到授权码，停在 "Missing code or state"。
// 所以这里单独预渲染一份同构的 SPA 外壳，让该路径直接 200 返回。
//
// ⚠️ 同时这也意味着：站点必须部署在根路径（base '/'），
//    因为上面的回调地址不含任何 base 前缀，子路径部署永远匹配不上。
import KeystaticAdmin from '../../../../components/KeystaticAdmin';

export const prerender = true;
---

<KeystaticAdmin client:only="react" />
