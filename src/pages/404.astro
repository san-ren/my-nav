---
// SPA Fallback - 处理 keystatic 子路由
// basePath 必须跟随 astro.config 的 base（github → /my-nav，root/admin → ""），
// 写死会导致换部署目标后后台刷新 404。
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" data-base={basePath}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>加载中...</title>
  <style>
    body { font-family: sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #f8fafc; }
    .loading { text-align: center; color: #64748b; }
  </style>
  <script is:inline>
    (function() {
      // basePath 来自 html[data-base]，由 frontmatter 注入，随部署目标自动变化。
      // 不能用 define:vars —— 它与 is:inline 冲突会导致变量注入失败。
      var basePath = document.documentElement.getAttribute('data-base') || '';
      var path = window.location.pathname;
      var keystaticPath = basePath + '/keystatic';
      
      // 检测是否是 keystatic 子路径
      if (path.startsWith(keystaticPath) && path !== keystaticPath + '/' && path !== keystaticPath) {
        // 保存「路径 + 查询串」，用于 SPA 恢复。
        // ⚠️ 查询串必须带上：Keystatic Cloud 的 OAuth 回调是
        //   ${origin}/keystatic/cloud/oauth/callback?code=...&state=...
        // 而该路径在产物里刻意不存在（存在就会被目录形式强制补斜杠 301，
        // 应用路由匹配不上会显示 Not found）。所以它一定落到本兜底页，
        // 若这里丢掉 ?code=&state=，登录就会停在 Missing code or state。
        sessionStorage.setItem('keystatic_spa_path', path + window.location.search);
        // 重定向到 SPA 入口
        window.location.replace(keystaticPath + '/');
        return;
      }
      
      // 非 keystatic 路径，显示 404
      document.body.innerHTML = '<div class="loading"><h1>404</h1><p>页面未找到</p><p><a href="' + basePath + '/">返回首页</a></p></div>';
    })();
  </script>
</head>
<body>
  <div class="loading"><p>加载中...</p></div>
</body>
</html>
